 /**
+ * L2S fix (Linexa patch 0002): lexically normalize the absolute path
+ * @in into @out (both PATH_MAX buffers).  "." and empty components are
+ * dropped, ".." pops the previous component (clamped at "/" as the
+ * kernel does for absolute paths).  Returns -ENAMETOOLONG on overflow,
+ * otherwise 0.  @in must be absolute.
+ */
+static int normalize_path(char out[PATH_MAX], const char in[PATH_MAX])
+{
+	const char *p = in;
+	char *o = out;
+
+	*o = '\0';
+	while (*p != '\0') {
+		const char *start;
+		size_t len;
+
+		while (*p == '/')
+			p++;
+		start = p;
+		while (*p != '\0' && *p != '/')
+			p++;
+		len = (size_t) (p - start);
+
+		if (len == 0 || (len == 1 && start[0] == '.'))
+			continue;
+
+		if (len == 2 && start[0] == '.' && start[1] == '.') {
+			/* Pop the last component, clamp at "/". */
+			if (o != out) {
+				while (o > out + 1 && *(o - 1) != '/')
+					o--;
+				if (o > out)
+					o--;
+				*o = '\0';
+			}
+			continue;
+		}
+
+		if ((size_t) (o - out) + len + 1 >= PATH_MAX)
+			return -ENAMETOOLONG;
+		if (o == out || *(o - 1) != '/')
+			*o++ = '/';
+		memcpy(o, start, len);
+		o += len;
+		*o = '\0';
+	}
+
+	if (o == out) {
+		out[0] = '/';
+		out[1] = '\0';
+	}
+
+	return 0;
+}
+
+/**
+ * L2S fix (Linexa patch 0002): resolve the symlink target stored in
+ * @target as the kernel would when dereferencing the symlink located
+ * at @link_path — i.e. a relative target is interpreted against the
+ * directory CONTAINING the link, never against PRoot's own process
+ * cwd (the historical behavior, which broke every lstat/rename/unlink
+ * over a ``.l2s.*`` member whose target was relative).
+ *
+ * @target is updated in place with the absolute, normalized result.
+ * Absolute targets are returned unchanged (the kernel ignores the
+ * link's directory for those too).  @link_path must be absolute and
+ * canonical, which always holds here: it originates from PRoot's
+ * translated syscall arguments, whose parent directories were already
+ * resolved.
+ *
+ * Lexical normalization is exact for link2symlink targets: PRoot only
+ * ever stores absolute targets or bare/real-directory-relative names,
+ * and every directory between the translated path root and the link is
+ * a real directory, so ".." segments climb real directories exactly
+ * like the kernel does.
+ *
+ * Returns -errno on failure, otherwise 0.
+ */
+static int resolve_target_in_place(const char link_path[PATH_MAX], char target[PATH_MAX])
+{
+	char work[PATH_MAX];
+	const char *last;
+	size_t dirlen;
+	size_t target_len;
+	int status;
+
+	if (target[0] == '\0')
+		return -ENOENT;
+	if (target[0] == '/')
+		return 0; /* absolute: same base the kernel would use */
+
+	last = strrchr(link_path, '/');
+	if (last == NULL)
+		return -EINVAL; /* link_path must be absolute here */
+	dirlen = (last == link_path) ? 1 : (size_t) (last - link_path);
+
+	target_len = strlen(target);
+	if (dirlen + 1 + target_len >= PATH_MAX)
+		return -ENAMETOOLONG;
+
+	memcpy(work, link_path, dirlen);
+	work[dirlen] = '/';
+	memcpy(work + dirlen + 1, target, target_len + 1);
+
+	status = normalize_path(target, work);
+	if (status < 0)
+		return status;
+
+	return 0;
+}
