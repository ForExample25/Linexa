<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?android:attr/colorControlNormal">

    <!-- Linexa glyph monoline — Home / Command Center.
         A dashboard with a pulse line, evoking a runtime status overview.
         24x24 viewport, 2dp stroke, rounded caps. Stroke-only — no fill —
         so the glyph reads cleanly at 16/20/24dp on the navigation bar. -->
    <path
        android:pathData="M4,13 L4,20 L10,20 L10,13 Z"
        android:strokeColor="@android:color/white"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M14,13 L14,20 L20,20 L20,13 Z"
        android:strokeColor="@android:color/white"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
